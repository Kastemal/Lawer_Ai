# Настройки подключения к OpenAI-совместимому API (платформа хакатона или внешний провайдер)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here

# Идентификаторы моделей
LLM_MODEL=deepseek/deepseek-v4.1-flash
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b

# Параметры поиска и инференса
DATA_DIR=data
TOP_K=10
RERANKER_TOP_N=4
TEMPERATURE=0.0
MAX_TOKENS=1024
MAX_WORKERS=3
